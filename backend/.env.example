# Copy to .env and fill in the values: cp .env.example .env

# Server
SERVER_PORT=9025

# Database (also used by the postgres container in docker-compose)
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=pro_bucket_tool
POSTGRES_USER=probucketool
POSTGRES_PASSWORD=change-me

# JWT - must be base64, generate one with: openssl rand -base64 64
JWT_SECRET=change-me
JWT_EXPIRATION_MS=18000000

# CORS - origin the frontend is served from
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Base URLs used in the links inside emails
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:9025

# Mail (SMTP) - for Gmail use an app password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=probucket@info.co.in

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:3002/oauth2/redirect
