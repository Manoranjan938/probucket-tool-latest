# Copy to .env and fill in the values: cp .env.example .env

# Server
SERVER_PORT=9025

# Database (also used by the postgres container in docker-compose)
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=pro_bucket_tool
POSTGRES_USER=probucketool
POSTGRES_PASSWORD=change-me

# JWT - must be base64 and decode to at least 64 bytes (HS512), generate one with:
# openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change-me
# Access token: 15 minutes. Refresh token: 7 days, renewed each time it is used
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
# Login cookies are HTTPS-only when true - set to true in production, false for local http
COOKIE_SECURE=false

# CORS - origin the frontend is served from
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Base URL used in the links inside emails
FRONTEND_URL=http://localhost:3000

# Mail (SMTP) - for Gmail use an app password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=probucket@info.co.in

# RabbitMQ - emails and other slow work go through it; the backend won't start without it.
# The rabbitmq container in docker-compose creates this user. Admin page: http://localhost:15672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=probucket
RABBITMQ_DEFAULT_PASS=change-me

# Redis - cache (the redis container in docker-compose uses this password)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:3002/oauth2/redirect
